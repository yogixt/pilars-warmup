# ---- Turso (libSQL) ----
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# ---- Resend (sending only) ----
# API key with sending permission. Each sending domain (thepilars.com,
# pilarsworks.com, hellopilars.com, meetpilars.com) must be verified in Resend.
RESEND_API_KEY=re_xxx

# ---- Zoho IMAP (inbound detection + engagement) ----
# Default IMAP host/port for mailboxes that don't set their own (Zoho India DC).
IMAP_HOST=imap.zoho.in
IMAP_PORT=993
# Per-mailbox app passwords are stored in the DB (see scripts/seed.ts), NOT here.

# Secret tag stamped on every warm-up email. The IMAP poller ONLY touches
# messages carrying this exact token, so it can never act on real mail.
WARMUP_TOKEN=change-me-to-something-unguessable

# ---- Anthropic (auto-reply generation) ----
ANTHROPIC_API_KEY=sk-ant-xxx
# Cheap + fast model for short human-like replies.
REPLY_MODEL=claude-haiku-4-5-20251001

# ---- Warm-up engine tuning ----
# Secret that protects /api/cron. Vercel Cron sends this automatically if set as CRON_SECRET.
CRON_SECRET=change-me
# Simple bearer token for the admin mailbox API (/api/mailboxes).
ADMIN_TOKEN=change-me

# Ramp: starting sends/day/mailbox, daily increment, and hard cap.
WARMUP_START_PER_DAY=4
WARMUP_DAILY_INCREMENT=3
WARMUP_MAX_PER_DAY=40
# Probability [0..1] that a received warm-up email gets an auto-reply.
WARMUP_REPLY_PROBABILITY=0.55
# Human-like reply delay window, in minutes.
WARMUP_REPLY_MIN_DELAY=3
WARMUP_REPLY_MAX_DELAY=45
# Active send window (UTC hours, 0-23) to look human. Sends only fire in this window.
WARMUP_SEND_HOUR_START=7
WARMUP_SEND_HOUR_END=21
# Stop auto-replying once a thread reaches this depth (avoids infinite ping-pong).
WARMUP_MAX_THREAD_DEPTH=4
# How many days back the IMAP poller looks for unseen warm-up mail.
WARMUP_INBOUND_LOOKBACK_DAYS=3
